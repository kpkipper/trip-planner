{
  "hosting": {
    "site": "jourlyplan",
    "public": "out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/opengraph-image",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/plans/*/edit",
        "destination": "/plans/_shell/edit.html"
      },
      {
        "source": "/plans/*",
        "destination": "/plans/_shell.html"
      },
      {
        "source": "/u/*",
        "destination": "/u/_shell.html"
      },
      {
        "source": "/join/*",
        "destination": "/join/_shell.html"
      }
    ]
  }
}
