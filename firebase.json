{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "jourlyplan",
    "public": "out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/auth/**",
        "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
      },
      {
        "source": "/join/**",
        "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
      },
      {
        "source": "**/opengraph-image",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/plans/*/edit",
        "destination": "/plans/_shell/edit.html"
      },
      {
        "source": "/plans/*",
        "destination": "/plans/_shell.html"
      },
      {
        "source": "/u/*",
        "destination": "/u/_shell.html"
      },
      {
        "source": "/join/*",
        "destination": "/join/_shell.html"
      }
    ]
  }
}
